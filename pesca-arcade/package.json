{
  "name": "pesca-arcade",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node tools/postbuild.mjs",
    "preview": "vite preview --port 4173",
    "shots": "node tools/shots.mjs",
    "sim": "node tools/sim.mjs",
    "test": "node tools/test-save.mjs && node tools/test-pwa.mjs",
    "perf": "node tools/perf.mjs",
    "icons": "node tools/icons.mjs",
    "android:init": "npm i @capacitor/core @capacitor/cli @capacitor/android @capacitor-community/admob cordova-plugin-purchase && npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "devDependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}