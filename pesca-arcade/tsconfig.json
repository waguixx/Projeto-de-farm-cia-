{
  "compilerOptions": {
    "target": "ES2019", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true, "noEmit": true, "allowJs": true, "checkJs": false,
    "skipLibCheck": true, "isolatedModules": true, "types": ["vite/client"]
  },
  "include": ["src"]
}
